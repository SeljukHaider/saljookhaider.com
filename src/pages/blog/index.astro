---
import SubPage from '../../layouts/SubPage.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-IE', { day: 'numeric', month: 'short', year: 'numeric' });
const mins = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 220));
const [lead, ...rest] = posts;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<SubPage
  title="Cyber security blog"
  heading="Blog"
  description="Practical cyber security writing by Saljook Haider: SOC detection with Splunk and Sysmon, Windows event logs, phishing analysis, MITRE ATT&CK, Python automation and incident analysis."
  intro="Practical notes from the blue team: detections, investigations, tooling and analysis of real-world incidents."
>
  {lead && (
    <a class="card lead" href={`/blog/${lead.id}/`}>
      <span class="glow" aria-hidden="true"></span>
      <p class="label"><span class="new">Latest</span> {fmt(lead.data.date)} · {mins(lead.body)} min read</p>
      <h2>{lead.data.title}</h2>
      {lead.data.description && <p class="muted">{lead.data.description}</p>}
      <ul class="chips">{lead.data.tags.map((t) => <li>#{t}</li>)}</ul>
      <span class="go">Read the analysis <Icon name="arrow" size={15} /></span>
    </a>
  )}

  <div class="grid">
    {rest.map((p) => (
      <a class="card post" href={`/blog/${p.id}/`}>
        <p class="label">{fmt(p.data.date)} · {mins(p.body)} min read</p>
        <h2>{p.data.title}</h2>
        {p.data.description && <p class="muted">{p.data.description}</p>}
        <ul class="chips">{p.data.tags.slice(0, 3).map((t) => <li>#{t}</li>)}</ul>
      </a>
    ))}
  </div>

  <section class="card topics" aria-label="Topics">
    <p class="label">Topics</p>
    <ul class="chips">{tags.map((t) => <li>#{t}</li>)}</ul>
    <p class="muted small"><a href="/rss.xml">Subscribe via RSS</a> to get new posts.</p>
  </section>
</SubPage>

<style>
  .lead { display: block; text-decoration: none; color: var(--text); padding: clamp(1.5rem, 4vw, 2.6rem); margin-bottom: 1.1rem; transition: border-color 0.2s, transform 0.2s; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--card)), var(--card) 55%); }
  .lead:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--text); }
  .glow { position: absolute; right: -120px; top: -120px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%); pointer-events: none; }
  .lead h2 { font-size: clamp(1.5rem, 3.2vw, 2.3rem); letter-spacing: -0.02em; max-width: 30ch; margin: 0.3rem 0 0.8rem; position: relative; }
  .lead p.muted { max-width: 75ch; margin: 0 0 1rem; position: relative; }
  .new { display: inline-block; background: var(--accent-btn); color: var(--on-accent); border-radius: 999px; padding: 0.05rem 0.55rem; margin-right: 0.4rem; font-weight: 700; letter-spacing: 0.04em; }
  .go { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.1rem; font-weight: 600; color: var(--accent-ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 1.1rem; }
  .post { display: flex; flex-direction: column; text-decoration: none; color: var(--text); transition: border-color 0.2s, transform 0.2s; }
  .post:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--text); }
  .post h2 { font-size: 1.2rem; margin: 0.2rem 0 0.6rem; }
  .post p.muted { margin: 0 0 1rem; flex: 1; font-size: 0.93rem; }
  .topics { margin-top: 1.1rem; }
  .topics .small { margin: 1rem 0 0; font-size: 0.9rem; }
  @media (max-width: 420px) { .grid { grid-template-columns: 1fr; } }
</style>

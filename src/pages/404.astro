---
import SubPage from '../layouts/SubPage.astro';
import profile from '../data/profile.json';
---
<SubPage title="Page not found" heading="404: nothing to see here" intro="This page doesn't exist, or it was moved. No alert raised." noindex>
  <section class="card term404 mono" aria-label="Error details">
    <p><span class="accent">{profile.handle}@soc:~$</span> cat <span id="path">this-page</span></p>
    <p class="muted">cat: No such file or directory</p>
    <p><span class="accent">{profile.handle}@soc:~$</span> ls ~</p>
    <p class="links"><a href="/">home/</a> <a href="/projects/">projects/</a> <a href="/blog/">blog/</a> <a href={profile.cv} download>cv.pdf</a></p>
  </section>
</SubPage>

<script>
  const el = document.getElementById('path');
  if (el) el.textContent = location.pathname;
</script>

<style>
  .term404 { font-size: 0.92rem; }
  .term404 p { margin: 0 0 0.5rem; word-break: break-all; }
  .links { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .links a { color: var(--accent-ink); }
</style>

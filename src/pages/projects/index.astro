---
import SubPage from '../../layouts/SubPage.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const others = all.filter((p) => !p.data.featured);
---
<SubPage
  title="Security investigations & projects"
  heading="Investigations & projects"
  description="SOC case studies by Saljook Haider: Splunk threat hunting, Wireshark network forensics, Windows DFIR with Volatility and KAPE, phishing analysis, and an LLM-based AppSec triage dissertation."
  intro="Detection playbooks and case studies showing how I investigate: the queries, filters and commands I run, what I look for, and how it maps to MITRE ATT&CK."
>
  <h2 class="section-label label">Featured investigations</h2>
  <div class="featured">
    {featured.map((p, i) => (
      <a class="card case" href={`/projects/${p.id}/`}>
        <span class="num mono">0{i + 1}</span>
        <span class="ico"><Icon name={p.data.icon} size={26} /></span>
        <p class="label">{p.data.kind}</p>
        <h3>{p.data.title}</h3>
        <p class="muted">{p.data.summary}</p>
        <ul class="chips">{p.data.mitre.slice(0, 4).map((m) => <li class="mono">{m.id}</li>)}</ul>
        <span class="go">Read case study <Icon name="arrow" size={15} /></span>
      </a>
    ))}
  </div>

  <h2 class="section-label label">More work</h2>
  <div class="others">
    {others.map((p) => (
      <a class="card case small" href={`/projects/${p.id}/`}>
        <span class="ico"><Icon name={p.data.icon} size={22} /></span>
        <p class="label">{p.data.kind}</p>
        <h3>{p.data.title}</h3>
        <p class="muted">{p.data.summary}</p>
        <ul class="chips">{p.data.tools.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
      </a>
    ))}
  </div>
</SubPage>

<style>
  .section-label { margin: 1.8rem 0 0.8rem; font-size: 0.78rem; }
  .featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .others { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.1rem; }
  .case { display: flex; flex-direction: column; text-decoration: none; color: var(--text); transition: border-color 0.2s, transform 0.2s; }
  .case:hover { border-color: var(--accent); transform: translateY(-3px); color: var(--text); }
  .case h3 { font-size: 1.25rem; margin-bottom: 0.6rem; }
  .case.small h3 { font-size: 1.1rem; }
  .case p.muted { margin: 0 0 1rem; flex: 1; font-size: 0.95rem; }
  .ico { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 14px; margin-bottom: 1rem; color: var(--accent-ink); background: color-mix(in srgb, var(--accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .num { position: absolute; top: 1.2rem; right: 1.5rem; font-size: 2.6rem; font-weight: 700; color: color-mix(in srgb, var(--text) 8%, transparent); }
  .go { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.1rem; font-weight: 600; font-size: 0.9rem; color: var(--accent-ink); }
  .case:hover .go :global(svg) { transform: translate(2px, -2px); }
  .go :global(svg) { transition: transform 0.2s; }
  @media (max-width: 960px) { .featured { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .others { grid-template-columns: 1fr; } }
</style>

---
import SubPage from '../../layouts/SubPage.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const toc = headings.filter((h) => h.depth === 2);
const attackUrl = (id: string) => `https://attack.mitre.org/techniques/${id.replace('.', '/')}/`;
const words = (project.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
---
<SubPage title={d.title} description={d.summary} heading={d.title} intro={d.summary}>
  <div class="meta card">
    <span class="kind"><Icon name={d.icon} size={18} /> {d.kind}</span>
    {d.context && <span class="ctx">{d.context}</span>}
    <span class="muted">{minutes} min read</span>
    {d.live && <a class="btn" href={d.live} target="_blank" rel="noopener">Live <Icon name="arrow" size={14} /></a>}
    {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener"><Icon name="github" size={16} /> Source</a>}
  </div>

  <div class="layout">
    <article class="card prose-card">
      <div class="prose"><Content /></div>
    </article>

    <aside class="side">
      {toc.length > 2 && (
        <nav class="card toc" aria-label="On this page">
          <p class="label">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      {d.tools.length > 0 && (
        <section class="card">
          <p class="label">Tools &amp; data</p>
          <ul class="chips">{d.tools.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}
      {d.mitre.length > 0 && (
        <section class="card attack">
          <p class="label">MITRE ATT&amp;CK</p>
          <ul class="plain">
            {d.mitre.map((m) => (
              <li>
                <a href={attackUrl(m.id)} target="_blank" rel="noopener"><span class="mono tid">{m.id}</span> {m.name}</a>
                <span class="muted tactic">{m.tactic}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>

  <nav class="pager" aria-label="More case studies">
    {prev ? <a class="card" href={`/projects/${prev.id}/`}><span class="label">← Previous</span>{prev.data.title}</a> : <span />}
    {next ? <a class="card next" href={`/projects/${next.id}/`}><span class="label">Next →</span>{next.data.title}</a> : <span />}
  </nav>
</SubPage>

<style>
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; padding-top: 1rem; padding-bottom: 1rem; margin-bottom: 1.1rem; font-size: 0.9rem; }
  .kind { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 600; color: var(--accent-ink); }
  .ctx { background: var(--chip); border: 1px solid var(--border); border-radius: 999px; padding: 0.15rem 0.75rem; font-size: 0.8rem; color: var(--muted); }
  .meta .btn { margin-left: auto; padding: 0.35rem 0.8rem; }
  .meta .btn + .btn { margin-left: 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 1.1rem; align-items: start; }
  .prose-card { padding: clamp(1.3rem, 4vw, 2.6rem); }
  .prose { max-width: 76ch; }
  .side { display: grid; gap: 1.1rem; position: sticky; top: 1rem; }
  .side .card { padding: 1.2rem 1.3rem; }
  .toc ol { margin: 0; padding-left: 1.1rem; font-size: 0.9rem; line-height: 1.9; }
  .toc a { text-decoration: none; color: var(--muted); }
  .toc a:hover { color: var(--accent-ink); }
  .attack li { margin-bottom: 0.7rem; font-size: 0.9rem; line-height: 1.35; }
  .attack a { text-decoration: none; display: block; font-weight: 600; }
  .tid { color: var(--accent-ink); font-size: 0.8rem; margin-right: 0.25rem; }
  .tactic { font-size: 0.78rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; margin-top: 1.1rem; }
  .pager a { text-decoration: none; display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600; transition: border-color 0.2s; }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; order: -1; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .toc { display: none; }
  }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .pager .next { text-align: left; } .meta .btn { margin-left: 0; } }
</style>

---
/**
 * Self-contained interactive terminal.
 * All content comes from src/data/profile.json + the blog collection,
 * so nothing here needs editing when your details change.
 * To add a command: add an entry to `commands` in the <script> below.
 * Commands with a `desc` show in `help`; leave `desc` out for hidden easter eggs.
 */
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({ title: p.data.title, date: p.data.date.toISOString().slice(0, 10), url: `/blog/${p.id}/` }));
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ name: p.data.title, kind: p.data.kind, description: p.data.summary, url: `/projects/${p.id}/` }));
const data = { profile, posts, projects };
---
<div class="term mono" aria-label="Interactive terminal">
  <div class="bar"><span></span><span></span><span></span><em>{profile.handle}@saljookhaider.com: ~</em></div>
  <div class="out" id="term-out" role="log" aria-live="polite"></div>
  <form id="term-form" autocomplete="off">
    <label for="term-in" class="prompt">{profile.handle}@soc:~$</label>
    <input id="term-in" spellcheck="false" autocapitalize="off" aria-label="Terminal input" placeholder="type help" />
  </form>
</div>
<script type="application/json" id="term-data" set:html={JSON.stringify(data)} />

<script>
  const { profile: P, posts, projects } = JSON.parse(document.getElementById('term-data')!.textContent!);
  const out = document.getElementById('term-out')!;
  const form = document.getElementById('term-form') as HTMLFormElement;
  const input = document.getElementById('term-in') as HTMLInputElement;
  const history: string[] = [];
  let hIdx = 0;
  const accents = ['red', 'amber', 'blue', 'purple', 'green'];
  const site = () => (window as any).site;

  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const k = (s: string) => `<span class="k">${esc(s)}</span>`;
  const link = (url: string, label = url) =>
    `<a href="${esc(url)}"${url.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>${esc(label)}</a>`;
  const print = (html: string, cls = 'res') => {
    const div = document.createElement('div');
    div.className = cls;
    div.innerHTML = html;
    out.appendChild(div);
    out.scrollTop = out.scrollHeight;
  };

  type Cmd = { desc?: string; run: (args: string[]) => string | void };
  const commands: Record<string, Cmd> = {
    help: {
      desc: 'list commands',
      run: () =>
        Object.entries(commands)
          .filter(([, c]) => c.desc)
          .map(([n, c]) => k(n.padEnd(12)) + esc(c.desc!))
          .join('\n') + '\n\n↑/↓ history · Tab autocomplete · Ctrl+L clear',
    },
    about: { desc: 'who I am', run: () => `${k(P.name)} · ${esc(P.role)} · ${esc(P.location)}\n\n${P.summary.map(esc).join('\n\n')}` },
    experience: {
      desc: 'where I have worked',
      run: () =>
        P.experience
          .map((e: any) => `${k(`${e.start} – ${e.end}`)}  ${esc(e.role)} @ ${esc(e.company)}\n${e.highlights.map((h: string) => '  › ' + esc(h)).join('\n')}`)
          .join('\n\n'),
    },
    projects: {
      desc: 'things I have built and investigated',
      run: () =>
        projects
          .map((p: any) => `${k(p.name)} <span class="m">[${esc(p.kind)}]</span>\n  ${esc(p.description)}${p.url ? '\n  ' + link(p.url) : ''}`)
          .join('\n\n') + `\n\nFull list: ${link('/projects/', '/projects')}`,
    },
    certs: {
      desc: 'certifications',
      run: () => P.certifications.map((c: any) => `${k('✔ ' + c.name)}\n  ${esc(c.issuer)} · ${esc(c.detail)}`).join('\n\n'),
    },
    skills: {
      desc: 'tools of the trade',
      run: () => P.skills.map((g: any) => `${k(g.group.padEnd(22))}${g.items.map(esc).join(', ')}`).join('\n'),
    },
    education: {
      desc: 'degrees',
      run: () => P.education.map((e: any) => `${k(`${e.start}–${e.end}`)}  ${esc(e.degree)}, ${esc(e.grade)}\n           ${esc(e.school)}`).join('\n'),
    },
    blog: {
      desc: 'latest posts (blog 1 opens the first)',
      run: ([n]) => {
        if (n && posts[+n - 1]) { location.href = posts[+n - 1].url; return 'opening…'; }
        return posts.length
          ? posts.slice(0, 10).map((p: any, i: number) => `[${i + 1}] ${p.date}  ${link(p.url, p.title)}`).join('\n')
          : 'No posts yet.';
      },
    },
    cv: { desc: 'download my CV', run: () => { window.open(P.cv, '_blank'); return `Opening ${link(P.cv, 'CV (PDF)')}…`; } },
    contact: {
      desc: 'get in touch',
      run: () =>
        [`${'email'.padEnd(10)}${link('mailto:' + P.email, P.email)}`, ...P.links.map((l: any) => `${l.label.toLowerCase().padEnd(10)}${link(l.url)}`)].join('\n') +
        `\n\n<span class="m">${esc(P.availability)}</span>`,
    },
    themes: {
      desc: 'change colours: themes blue | themes light',
      run: ([t]) => {
        const d = document.documentElement;
        if (!t) return `accents: ${accents.join(', ')}\nmodes:   dark, light\ncurrent: ${d.dataset.accent} / ${d.dataset.theme}`;
        if (accents.includes(t)) { site().setAccent(t); return `Accent set to ${t}.`; }
        if (t === 'dark' || t === 'light') { site().setTheme(t); return `Switched to ${t} mode.`; }
        return `Unknown theme "${esc(t)}". Try ${k('themes')}.`;
      },
    },
    clear: { desc: 'clear the screen', run: () => { out.innerHTML = ''; } },

    // ---- easter eggs (hidden from help) ----
    whoami: { run: () => 'visitor (uid=1337) groups=curious,recruiters?' },
    ls: { run: () => 'about.txt  certs/  experience/  projects/  blog/  cv.pdf  .secrets/' },
    cat: { run: ([f]) => (f === 'about.txt' ? (commands.about.run([]) as string) : f?.startsWith('.secrets') ? 'Permission denied.' : `cat: ${esc(f || '')}: No such file`) },
    cd: { run: () => 'Nice try. Everything you need is in `help`.' },
    sudo: { run: () => `${esc(P.handle)} is not in the sudoers file. This incident will be reported. 🚨\n<span class="m">(…to the SOC. Which is me.)</span>` },
    'rm': { run: (a) => (a.join(' ').includes('-rf') ? 'Blocked by EDR. Host isolated. Ticket raised. 🛡️' : 'rm: missing operand') },
    nmap: { run: () => 'Starting Nmap…\nPORT    STATE  SERVICE\n22/tcp  closed ssh\n80/tcp  open   http  → you are here\n443/tcp open   https → hire-me\n\nNmap done: 1 IP address (1 host up, very employable)' },
    ping: { run: () => `PING ${esc(P.handle)}: replies within one business day.\nTry ${k('contact')}.` },
    hack: { run: () => 'Access granted… to my CV. Type ' + k('cv') + '.' },
    alerts: { run: () => `Triage queue: 0 open. ${Math.floor(Math.random() * 3) + 1} false positives tuned away today. ☕` },
    coffee: { run: () => '  ( (\n   ) )\n ........\n |      |]\n \\      /\n  `----\'\nRefuelling the SOC. ☕' },
    matrix: { run: () => { site().setAccent('green'); site().setTheme('dark'); return 'Wake up, Neo… 🟩'; } },
    date: { run: () => new Date().toString() },
    echo: { run: (a) => esc(a.join(' ')) },
    exit: { run: () => 'There is no escape. (But the tiles around this one are clickable.)' },
  };

  const exec = (raw: string) => {
    const line = raw.trim();
    print(`<span class="prompt">${esc(P.handle)}@soc:~$</span> ${esc(line)}`, 'cmd');
    if (!line) return;
    history.push(line); hIdx = history.length;
    const [name, ...args] = line.split(/\s+/);
    const cmd = commands[name.toLowerCase()];
    const res = cmd ? cmd.run(args) : `command not found: ${esc(name)}. Type ${k('help')}.`;
    if (res) print(res);
  };

  form.addEventListener('submit', (e) => { e.preventDefault(); exec(input.value); input.value = ''; });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && hIdx > 0) { input.value = history[--hIdx]; e.preventDefault(); }
    else if (e.key === 'ArrowDown') { hIdx = Math.min(hIdx + 1, history.length); input.value = history[hIdx] ?? ''; e.preventDefault(); }
    else if (e.key === 'Tab') {
      e.preventDefault();
      const m = Object.keys(commands).filter((c) => commands[c].desc && c.startsWith(input.value));
      if (m.length === 1) input.value = m[0];
      else if (m.length > 1) print(m.join('  '));
    } else if (e.key === 'l' && e.ctrlKey) { e.preventDefault(); out.innerHTML = ''; }
  });
  document.querySelector('.term')!.addEventListener('click', () => {
    if (!window.getSelection()?.toString()) input.focus({ preventScroll: true });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-term-cmd]').forEach((b) =>
    b.addEventListener('click', () => exec(b.dataset.termCmd!)));
  print(`Welcome. I'm ${esc(P.firstName)}, and this terminal actually works. Type ${k('help')} or tap a command below.`);
</script>

<style>
  .term { display: flex; flex-direction: column; height: 100%; min-height: 340px; font-size: 0.85rem; }
  .bar { display: flex; gap: 6px; align-items: center; padding-bottom: 0.8rem; }
  .bar span { width: 11px; height: 11px; border-radius: 50%; background: var(--border); }
  .bar span:first-child { background: var(--accent); }
  .bar em { margin-left: auto; font-style: normal; color: var(--muted); font-size: 0.75rem; }
  .out { flex: 1 1 0; min-height: 260px; max-height: 440px; overflow-y: auto; white-space: pre-wrap; word-break: break-word; scrollbar-width: thin; }
  .out :global(.res) { margin: 0.15rem 0 0.7rem; }
  .out :global(.k) { color: var(--accent-ink); }
  .out :global(.m) { color: var(--muted); }
  .out :global(a) { color: var(--accent-ink); }
  form { display: flex; gap: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--border); }
  .prompt, .out :global(.prompt) { color: var(--accent-ink); white-space: nowrap; }
  input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--text); font: inherit; caret-color: var(--accent); }
  input::placeholder { color: var(--muted); opacity: 0.6; }
  form:focus-within { border-top: 1px solid var(--accent); }
  @media (max-width: 680px) {
    .term { min-height: 0; }
    .out { min-height: 150px; max-height: 360px; }
  }
</style>

---
import '../styles/global.css';
import profile from '../data/profile.json';
import jakarta from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import jetbrains from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  noindex?: boolean;
}
const {
  title,
  description = `${profile.name}: ${profile.role} in ${profile.location}. ${profile.headline}.`,
  type = 'website',
  published,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const isHome = Astro.url.pathname === '/';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  image: ogImage.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Dublin', addressCountry: 'IE' },
  sameAs: profile.links.map((l) => l.url),
  hasCredential: profile.certifications.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: c.name })),
  knowsAbout: profile.skills.flatMap((g) => g.items).slice(0, 20),
};
const articleLd = published && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: published.toISOString(),
  url: canonical.toString(),
  image: ogImage.toString(),
  author: { '@type': 'Person', name: profile.name, url: Astro.site?.toString() },
};
---
<!doctype html>
<html lang="en-IE" data-theme="dark" data-accent="red">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={jakarta} as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href={jetbrains} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} · Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0d0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f2ef" media="(prefers-color-scheme: light)" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <script is:inline>
      try {
        const d = document.documentElement;
        const t = localStorage.getItem('theme'); if (t) d.dataset.theme = t;
        const a = localStorage.getItem('accent'); if (a) d.dataset.accent = a;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page"><slot /></div>
    <script>
      // Shared helpers for theme + accent, used by the swatches and the terminal.
      const d = document.documentElement;
      const save = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
      const sync = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-set-accent]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.setAccent === d.dataset.accent)));
        document.querySelectorAll<HTMLButtonElement>('[data-toggle-theme]').forEach((b) =>
          b.setAttribute('aria-pressed', String(d.dataset.theme === 'light')));
      };
      (window as any).site = {
        setAccent: (a: string) => { d.dataset.accent = a; save('accent', a); sync(); },
        setTheme: (t: string) => { d.dataset.theme = t; save('theme', t); sync(); },
      };
      document.querySelectorAll<HTMLButtonElement>('[data-set-accent]').forEach((b) =>
        b.addEventListener('click', () => (window as any).site.setAccent(b.dataset.setAccent!)));
      document.querySelectorAll<HTMLButtonElement>('[data-toggle-theme]').forEach((b) =>
        b.addEventListener('click', () => (window as any).site.setTheme(d.dataset.theme === 'light' ? 'dark' : 'light')));
      sync();
    </script>
  </body>
</html>

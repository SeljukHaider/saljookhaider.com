{
  // Cloudflare Workers config: serves the static Astro build from ./dist
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saljookhaider",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "saljookhaider.com", "custom_domain": true },
    { "pattern": "www.saljookhaider.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
